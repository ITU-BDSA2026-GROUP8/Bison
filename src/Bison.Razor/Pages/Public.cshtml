@page "/"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Public timeline";
    Layout = "Shared/_Layout";
}
<div>
    <h2> Public Timeline </h2>
           @if(User.Identity.IsAuthenticated){

    <form method="post" enctype="multipart/form-data">
        <div class="observationbox">
        <h3>What did you see, @(User.Identity.Name)?</h3>
        <div asp-validation-summary="All"></div>
        <label asp-for="Message"></label>
        <input asp-for="Message" required />
        <label asp-for="Location"></label>
        <input asp-for="Location" required />
        <!-- <label asp-for="ImageUrl"></label> -->
        <!-- <input asp-for="ImageUrl" /> -->
        <label>Image</label>
        <input type="file" asp-for="ImageFile" accept="image/*" />
        <label asp-for="ImageLicense"></label>
        <select asp-for="ImageLicense">
            <option value="">Choose Image License</option>
            <option value="CC BY">CC BY</option>
            <option value="CC BY-NC">CC BY-NC</option>
            <option value="CC BY-NC-ND">CC BY-NC-ND</option>
            <option value="CC BY-NC-SA">CC BY-NC-SA</option>
            <option value="CC BY-ND">CC BY-ND</option>
            <option value="CC BY-SA">CC BY-SA</option>
        </select>
        
        <button type="submit" class="page-button">Post observation</button>
            </div>
        </form>
    }
    
    <partial name="_Pagination" model="Model.CurrentPage" />
    <partial name="_TaxonFilterPartial" />

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@obs.Author.UserName">@obs.Author.UserName</a>
                        </strong>
                        @obs.Text
                        <small>&mdash; @obs.Timestamp</small>
                       
                        <a href="/ob/@obs.Id">View observation details</a>
                        
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }

    <partial name="_Pagination" model="Model.CurrentPage" />

</div>
