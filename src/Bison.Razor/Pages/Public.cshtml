@page "/"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>

    <form method="post">
        <div asp-validation-summary="All"></div>
        <label asp-for="Message"></label>
        <input asp-for="Message" required />
        <label asp-for="Location"></label>
        <input asp-for="Location" required />
        <button type="submit">Post observation</button>
    </form>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@obs.Author.Name">@obs.Author.Name</a>
                        </strong>
                        @obs.Text
                        <small>&mdash; @obs.Timestamp</small>
                        <a href="/ob/@obs.Id">View comments</a>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
