@page "/ob/{id:int}"
@model Bison.Razor.Pages.ObservationModel
@{
    ViewData["Title"] = "Observation";
    Layout = "Shared/_Layout";
}

<div>
    <h2>Observation</h2>
    <p>
        <strong>
            @if (Model.Observation.Author != null)
            {
                <a href="/@Model.Observation.Author.UserName">@Model.Observation.Author.UserName</a>
            }
            else
            {
                <span>Unknown author</span>
            }
        </strong>
        @Model.Observation.Text
        <small>&mdash; @Model.Observation.Timestamp</small>
    </p>
@if(Model._Taxon==null){
    <h4>Taxonomies</h4>
        <div class="observationbox">    
            <h3>What did you see, @(User.Identity.Name)?</h3>
            <form method="post">
                <div asp-validation-summary="All"></div>
        <label asp-for="Name"></label>
        <input asp-for="Name" required />
        <button type="submit">Post proposal</button>
            </form>
        </div>
    }
@if (Model._Taxon!=null)
    {
        <ul>
            <li>
                @Model._Taxon.DanishVernacularName
            </li>
        </ul>
    }
    else
    {
        <em>There are no Taxon for this observation yet.</em>
    }
    
    <h3>Comments</h3>
    
    @if (Model.Comments.Count > 0)
    {
        <ul>
            @foreach (var comment in Model.Comments)
            {
                <li>@comment.Text</li>
            }
        </ul>
    }
    else
    {
        <em>There are no comments for this observation yet.</em>
    }
</div>
