@page "/ob/{id:int}"
@model Bison.Razor.Pages.ObservationModel
@{
    ViewData["Title"] = "Observation";
    Layout = "Shared/_Layout";
}

<div>
    <h2>Observation</h2>
    <p>
        <strong>
            @if (Model.Observation.Author != null)
            {
                <a href="/@Model.Observation.Author.Name">@Model.Observation.Author.Name</a>
            }
            else
            {
                <span>Unknown author</span>
            }
        </strong>
        @Model.Observation.Text
        <small>&mdash; @Model.Observation.Timestamp</small>
    </p>
    <h4>Taxonomies</h4>
@if (Model._Taxon!=null)
    {
        <ul>
            <li>
                @Model._Taxon.DanishVernacularName
            </li>
        </ul>
    }
    else
    {
        <em>There are no Taxon for this observation yet.</em>
    }
    
    <h3>Comments</h3>
    
    @if (Model.Comments.Count > 0)
    {
        <ul>
            @foreach (var comment in Model.Comments)
            {
                <li>@comment.Text</li>
            }
        </ul>
    }
    else
    {
        <em>There are no comments for this observation yet.</em>
    }
</div>
