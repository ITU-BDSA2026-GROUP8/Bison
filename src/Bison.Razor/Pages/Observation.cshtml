@page "/ob/{id:int}"
@using SimpleDB
@model Bison.Razor.Pages.ObservationModel
@{
    ViewData["Title"] = "Observation";
    Layout = "Shared/_Layout";
}

<div>
    <h2>Observation</h2>
    <p>
        <strong><a href="/@Model.Observation.Author.Name">@Model.Observation.Author.Name</a></strong>
        @Model.Observation.Text
        <small>&mdash; @Model.Observation.Timestamp</small>
    </p>
    <h4>Taxonomies</h4>
@if (Model.Proposals.Count > 0)
    {
        <ul>
            @foreach(var proposal in Model.Proposals)
            {
                <li>

                    @foreach (var taxon in Model.Taxons){
                        if (taxon.taxonID == proposal.taxonID)
                        {
                            @taxon.ScientificName
                        }
                    }
                </li>
                
            }
        </ul>
    }
    
    <h3>Comments</h3>
    
    @if (Model.Comments.Count > 0)
    {
        <ul>
            @foreach (var comment in Model.Comments)
            {
                <li>@comment.Message</li>
            }
        </ul>
    }
    else
    {
        <em>There are no comments for this observation yet.</em>
    }
</div>
