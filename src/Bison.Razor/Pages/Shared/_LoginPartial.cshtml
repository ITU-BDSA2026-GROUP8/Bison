@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject Bison.Infrastructure.Services.IObservationFilterService TaxonFilter
@{
    var taxonNames = TaxonFilter.GetTaxonNames();
    var selectedTaxon = Context.Request.Query["taxon"].ToString();
}

<div class="navigation">

<div>
    @if (SignInManager.IsSignedIn (User))
        {
            <a href="/@User.Identity!.Name">My Observations</a> <text>|</text>
        }

<a href="/">Public Observations</a> |
<form method ="get" action="/">
    <select name="taxon" class="taxon-select" onchange="this.form.submit()">
        <option value="">All Taxa</option>
        @foreach (var taxon in taxonNames)
        {
            <option value="@taxon" selected="@(taxon == selectedTaxon ? "selected" : null)"> @taxon</option>
        }
    </select>
</form> |
    @if (SignInManager.IsSignedIn (User))
        {
        <a href="/About_Me/@User.Identity!.Name"> About Me</a> 
        <form method="post" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="/" style="display:inline">
            <button type="submit" style="all:unset;cursor:pointer">
                Logout [@User.Identity.Name]
            </button>
        </form>
        }
else {
    <a asp-area="Identity" asp-page="/Account/Register">Register</a> <text>|</text>
            <a asp-area="Identity" asp-page="/Account/Login">Login</a>
}
    </div>
</div>
