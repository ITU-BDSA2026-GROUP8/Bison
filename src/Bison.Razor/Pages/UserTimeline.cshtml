@page "/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2> @routeName's Observations </h2>
    <form method="get">
        <input type="hidden" name="page" value="@(Math.Max(1, Model.CurrentPage - 1))" />
        <button type="submit" disabled="@(Model.CurrentPage <= 1)">previous page</button>
    </form>

    <form method="get">
        <input type="hidden" name="page" value="@(Model.CurrentPage + 1)" />
        <button type="submit">next page</button>
    </form>
    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@ob.Author.UserName">@ob.Author.UserName</a>
                        </strong>
                        @ob.Text
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
</div>
